{
  "sections": [
    {
      "name": "Main",
      "binds": [
        {
          "keys": "SUPER + H",
          "description": "This Menu",
          "action": "qs -c end4-pC ipc call cheatsheet toggle"
        },
        {
          "keys": "SUPER",
          "description": "App Launcher",
          "action": "qs -c end4-pC ipc call search toggle"
        },
        {
          "keys": "SUPER + Q",
          "description": "Close Active Window",
          "action": "hyprctl dispatch 'hl.dsp.window.close()'"
        }
      ]
    },
    {
      "name": "Utils",
      "binds": [
        {
          "keys": "SUPER + I",
          "description": "Settings",
          "action": "XDG_CURRENT_DESKTOP=gnome ~/.config/hypr/hyprland/scripts/launch_first_available.sh \"qs -p ~/.config/quickshell/end4-pC/settings.qml\" systemsettings gnome-control-center better-control"
        },
        {
          "keys": "N/A",
          "description": "Session Menu",
          "action": "qs -c end4-pC ipc call session toggle"
        },
        {
          "keys": "CTRL + ALT + Semicolon",
          "description": "On Screen Keyboard",
          "action": "qs -c end4-pC ipc call osk toggle"
        },
        {
          "keys": "CTRL + ALT + W",
          "description": "Toggle Bar",
          "action": "qs -c end4-pC ipc call bar toggle"
        },
        {
          "keys": "SUPER + L",
          "description": "Lockscreen",
          "action": "loginctl lock-session"
        },
        {
          "keys": "SUPER + SHIFT + G",
          "description": "Toggle Overlay",
          "action": "qs -c end4-pC ipc call overlay toggle"
        },
        {
          "keys": "CTRL + ALT + BACKSPACE",
          "description": "Task Manager",
          "action": "~/.config/hypr/hyprland/scripts/launch_first_available.sh 'kitty -1 fish -c btop' 'gnome-system-monitor' 'plasma-systemmonitor --page-name Processes'"
        },
        {
          "keys": "SUPER + SHIFT + O",
          "description": "OCR",
          "action": "qs -c end4-pC ipc call region ocr"
        },
        {
          "keys": "CTRL + ALT + S",
          "description": "Google Image Search",
          "action": "qs -c end4-pC ipc call region search"
        },
        {
          "keys": "CTRL + ALT + T",
          "description": "Translate Screen Content",
          "action": "qs -c end4-pC ipc call screenTranslator translate"
        },
        {
          "keys": "SUPER + MINUS",
          "description": "Zoom out"
        },
        {
          "keys": "SUPER + EQUAL",
          "description": "Zoom In"
        }
      ]
    },
    {
      "name": "Recording",
      "binds": [
        {
          "keys": "N/A",
          "description": "Record Fullscreen (Without Sound)",
          "action": "~/.config/quickshell/end4-pC/scripts/videos/record.sh --fullscreen"
        },
        {
          "keys": "SHIFT + SUPER + R",
          "description": "Record Fullscreen (With Sound)",
          "action": "~/.config/quickshell/end4-pC/scripts/videos/record.sh --fullscreen --sound"
        },
        {
          "keys": "N/A",
          "description": "Record Region",
          "action": "qs -c end4-pC ipc call region record"
        }
      ]
    },
    {
      "name": "Screenshot",
      "binds": [
        {
          "keys": "Print",
          "description": "Screenshot (Active Monitor)",
          "action": "mkdir -p \"$(xdg-user-dir PICTURES)/Screenshots\" && grim -o \"$(hyprctl activeworkspace -j | jq -r '.monitor')\" \"$(xdg-user-dir PICTURES)/Screenshots/Screenshot_$(date '+%d-%m-%Y_%H.%M.%S').png\" && $HOME/.config/hypr/custom/scripts/Sounds.sh --screenshot"
        },
        {
          "keys": "CTRL + Print",
          "description": "Screenshot (Select Region)",
          "action": "sleep 0.50 && qs -c end4-pC ipc call region screenshot && $HOME/.config/hypr/custom/scripts/Sounds.sh --screenshot"
        }
      ]
    },
    {
      "name": "Apps",
      "binds": [
        {
          "keys": "SUPER + K",
          "description": "Terminal",
          "action": "~/.config/hypr/hyprland/scripts/launch_first_available.sh 'kitty -1' 'foot' 'alacritty' 'wezterm' 'konsole' 'kgx' 'uxterm' 'xterm'"
        },
        {
          "keys": "SUPER + B",
          "description": "Browser",
          "action": "~/.config/hypr/hyprland/scripts/launch_first_available.sh 'firefox' 'brave' 'google-chrome-stable' 'zen-browser' 'chromium' 'microsoft-edge-stable' 'opera' 'librewolf'"
        },
        {
          "keys": "SUPER + E",
          "description": "File Manager",
          "action": "~/.config/hypr/hyprland/scripts/launch_first_available.sh 'dolphin' 'nautilus' 'nemo' 'thunar' 'kitty -1 fish -c yazi'"
        },
        {
          "keys": "SUPER + O",
          "description": "Notes App",
          "action": "~/.config/hypr/hyprland/scripts/launch_first_available.sh 'obsidian'"
        },
        {
          "keys": "SUPER + G",
          "description": "Gparted",
          "action": "xhost +SI:localuser:root && gparted"
        },
        {
          "keys": "SUPER + N",
          "description": "Notification Center",
          "action": "qs -c end4-pC ipc call sidebarRight toggle"
        },
        {
          "keys": "SUPER + A",
          "description": "Toggle Left Sidebar",
          "action": "qs -c end4-pC ipc call sidebarLeft toggle"
        },
        {
          "keys": "SUPER + V",
          "description": "Clipboard Manager",
          "action": "qs -c end4-pC ipc call search clipboardToggle"
        },
        {
          "keys": "SUPER + T",
          "description": "Text Editor",
          "action": "~/.config/hypr/hyprland/scripts/launch_first_available.sh 'kate' 'gnome-text-editor' 'emacs'"
        },
        {
          "keys": "SUPER + C",
          "description": "VS Code",
          "action": "code"
        },
        {
          "keys": "N/A",
          "description": "Music Player",
          "action": "~/.config/hypr/hyprland/scripts/launch_first_available.sh 'rhythmbox'"
        }
      ]
    },
    {
      "name": "Eye-Candy",
      "binds": [
        {
          "keys": "N/A",
          "description": "Select Wallpaper",
          "action": "qs -c end4-pC ipc call wallpaperSelector toggle"
        },
        {
          "keys": "N/A",
          "description": "Toggle Blur",
          "action": "~/.config/hypr/custom/scripts/ChangeBlur.sh"
        },
        {
          "keys": "SHIFT + SUPER + W",
          "description": "Random Wallpaper",
          "action": "qs -c end4-pC ipc call wallpaperSelector random"
        },
        {
          "keys": "SHIFT + SUPER + T",
          "description": "Toggle Theme Mode",
          "action": "bash $HOME/.config/quickshell/end4-pC/scripts/colors/switchwall.sh --mode \"$([ \"$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d \"'\")\" = prefer-dark ] && echo light || echo dark)\" --noswitch"
        },
        {
          "keys": "N/A",
          "description": "Restart Widgets",
          "action": "killall ydotool qs quickshell; sleep 0.5; setsid qs -c end4-pC -d"
        },
        {
          "keys": "SHIFT + SUPER + C",
          "description": "Color Picker",
          "action": "hyprpicker -a"
        }
      ]
    },
    {
      "name": "Window",
      "binds": [
        {
          "keys": "ALT + TAB",
          "description": "Cycle Window Focus",
          "action": "~/.config/hypr/custom/scripts/LuaCycleWindow.sh next"
        },
        {
          "keys": "CTRL + ALT + H",
          "description": "Focus to Window",
          "action": "hyprctl dispatch 'hl.dsp.focus({direction = \"l\"})'"
        },
        {
          "keys": "CTRL + ALT + L",
          "description": "Focus to Window",
          "action": "hyprctl dispatch 'hl.dsp.focus({direction = \"r\"})'"
        },
        {
          "keys": "CTRL + ALT + K",
          "description": "Focus to Window",
          "action": "hyprctl dispatch 'hl.dsp.focus({direction = \"u\"})'"
        },
        {
          "keys": "CTRL + ALT + J",
          "description": "Focus to Window",
          "action": "hyprctl dispatch 'hl.dsp.focus({direction = \"d\"})'"
        },
        {
          "keys": "SUPER + CTRL + ALT + Y",
          "description": "Move Window to",
          "action": "hyprctl dispatch 'hl.dsp.window.move({direction = \"l\"})'"
        },
        {
          "keys": "SUPER + CTRL + ALT + O",
          "description": "Move Window to",
          "action": "hyprctl dispatch 'hl.dsp.window.move({direction = \"r\"})'"
        },
        {
          "keys": "SUPER + CTRL + ALT + I",
          "description": "Move Window to",
          "action": "hyprctl dispatch 'hl.dsp.window.move({direction = \"u\"})'"
        },
        {
          "keys": "SUPER + CTRL + ALT + U",
          "description": "Move Window to",
          "action": "hyprctl dispatch 'hl.dsp.window.move({direction = \"d\"})'"
        },
        {
          "keys": "SUPER + Drag Mouse",
          "description": "Move Window with Mouse",
          "action": "hyprctl dispatch movewindow"
        }
      ]
    },
    {
      "name": "Workspace",
      "binds": [
        {
          "keys": "SUPER + SHIFT + Mouse Scroll",
          "description": "Move Window To workspace"
        }
      ]
    },
    {
      "name": "Media",
      "binds": [
        {
          "keys": "N/A",
          "description": "Sound App",
          "action": "~/.config/hypr/hyprland/scripts/launch_first_available.sh 'pavucontrol-qt' 'pavucontrol'"
        },
        {
          "keys": "XF86AudioLowerVolume",
          "description": "Decrease Volume",
          "action": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
        },
        {
          "keys": "XF86AudioRaiseVolume",
          "description": "Increase Volume",
          "action": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ -l 1.5"
        },
        {
          "keys": "XF86MonBrightnessDown",
          "description": "Decrease Brightness",
          "action": "swayosd-client --brightness lower"
        },
        {
          "keys": "XF86MonBrightnessUp",
          "description": "Increase Brightness",
          "action": "swayosd-client --brightness raise"
        },
        {
          "keys": "XF86AudioMute",
          "description": "Toggle Mute (Speaker)",
          "action": "wpctl set-mute @DEFAULT_SINK@ toggle"
        },
        {
          "keys": "XF86AudioMicMute",
          "description": "Toggle Mute (Mic)",
          "action": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
        },
        {
          "keys": "XF86AudioPause",
          "description": "Media Pause/Play",
          "action": "~/.config/hypr/custom/scripts/MediaCtrl.sh --pause"
        },
        {
          "keys": "XF86AudioNext",
          "description": "Media Play-Next",
          "action": "~/.config/hypr/custom/scripts/MediaCtrl.sh --nxt"
        },
        {
          "keys": "XF86AudioPrev",
          "description": "Media Play-Prev",
          "action": "~/.config/hypr/custom/scripts/MediaCtrl.sh --prv"
        }
      ]
    },
